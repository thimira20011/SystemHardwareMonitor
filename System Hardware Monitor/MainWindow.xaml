<Window x:Class="System_Hardware_Monitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:System_Hardware_Monitor"
        mc:Ignorable="d"
        Title="My Rig Monitor" Height="200" Width="300" Background="#1e1e1e" WindowStartupLocation="CenterScreen">
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
        <TextBlock Text="GPU TEMPERATURE"
                   Foreground="Gray"
                   FontSize="14"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,4"/>
        <TextBlock Text="{Binding GpuTemp}"
                   Foreground="#00ff00"
                   FontSize="48"
                   FontWeight="Bold"
                   HorizontalAlignment="Center"/>
    </StackPanel>
</Window>